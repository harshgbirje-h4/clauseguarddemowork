{
  "manifest_version": 3,
  "name": "ClauseGuard Privacy Analyzer",
  "version": "1.0",
  "description": "Analyze privacy policies using the ClauseGuard backend.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
